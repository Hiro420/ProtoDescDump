<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ProtoDescDump.Cli</AssemblyName>
    <RootNamespace>ProtoDescDump.Cli</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>protodescdump</ToolCommandName>
    <RollForward>Major</RollForward>

    <PackageId>ProtoDescDump.Cli</PackageId>
    <Title>ProtoDescDump CLI</Title>
    <Description>Recover protocol definitions from protobuf descriptors</Description>
    <PackageTags>protobuf;proto;descriptor;schema;grpc;rpc;dotnet-tool;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProtoDescDump.Core/ProtoDescDump.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProtoDescDump.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
  </ItemGroup>
</Project>
